#include <stdio.h>

struct Student {
    char name[50];
    int roll_no;
    float marks;
};

struct Student topStudent(struct Student s[], int n) {
    int max = 0;

    for(int i = 1; i < n; i++) {
        if(s[i].marks > s[max].marks)
            max = i;
    }

    return s[max];
}

int main() {
    struct Student s[3] = {
        {"Rahul", 101, 85.5},
        {"Aman", 102, 95.0},
        {"Raj", 103, 78.0}
    };

    struct Student top = topStudent(s, 3);

    printf("Top Student Details\n");
    printf("Name: %s\n", top.name);
    printf("Roll Number: %d\n", top.roll_no);
    printf("Marks: %.2f\n", top.marks);

    return 0;
}
