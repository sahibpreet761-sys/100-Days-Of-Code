#include <stdio.h>

int main() {
    int arr[100], n;
    int i, sum = 0, total, missing;

    printf("Enter the size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum = sum + arr[i];
    }

    // Sum of integers from 0 to n
    total = n * (n + 1) / 2;

    missing = total - sum;

    printf("Missing number: %d", missing);

    return 0;
}
