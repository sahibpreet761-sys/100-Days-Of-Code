#include <stdio.h>
#include <string.h>

int main() {
    char s[1000];
    int i, j, len, maxLen = 0;

    printf("Enter a string: ");
    fgets(s, sizeof(s), stdin);

    len = strlen(s);

    if (s[len - 1] == '\n') {
        s[len - 1] = '\0';
        len--;
    }

    for (i = 0; i < len; i++) {
        int visited[256] = {0};
        int count = 0;

        for (j = i; j < len; j++) {
            if (visited[(unsigned char)s[j]] == 1) {
                break;
            }

            visited[(unsigned char)s[j]] = 1;
            count++;
        }

        if (count > maxLen) {
            maxLen = count;
        }
    }

    printf("Length of longest substring: %d\n", maxLen);

    return 0;
}
