#include <stdio.h>

int main() {
    int arr[100], n, k;
    int i, sum = 0, maxSum;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter subarray size k: ");
    scanf("%d", &k);

    if (k <= 0 || k > n) {
        printf("Invalid value of k\n");
        return 0;
    }

    // Calculate sum of first k elements
    for (i = 0; i < k; i++) {
        sum += arr[i];
    }

    maxSum = sum;

    // Check remaining subarrays using sliding window
    for (i = k; i < n; i++) {
        sum = sum - arr[i - k] + arr[i];

        if (sum > maxSum) {
            maxSum = sum;
        }
    }

    printf("Maximum subarray sum: %d\n", maxSum);

    return 0;
}
