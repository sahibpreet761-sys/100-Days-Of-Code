#include <stdio.h>

int main() {
    char name[100];
    int i;

    printf("Enter your full name: ");
    fgets(name, sizeof(name), stdin);

    printf("Initials: ");

    // Print the first character
    if (name[0] != ' ' && name[0] != '\n') {
        printf("%c", name[0]);
    }

    // Print characters after spaces
    for (i = 1; name[i] != '\0'; i++) {
        if (name[i - 1] == ' ' && name[i] != ' ' && name[i] != '\n') {
            printf(".%c", name[i]);
        }
    }

    printf("\n");

    return 0;
}
