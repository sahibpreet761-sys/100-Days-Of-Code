#include <stdio.h>

int main() {
    int arr[100], n;
    int i, j, previous;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Previous Greater Elements: ");

    for (i = 0; i < n; i++) {
        previous = -1;

        for (j = i - 1; j >= 0; j--) {
            if (arr[j] > arr[i]) {
                previous = arr[j];
                break;
            }
        }

        printf("%d", previous);

        if (i < n - 1) {
            printf(", ");
        }
    }

    printf("\n");

    return 0;
}
